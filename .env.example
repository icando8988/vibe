# 변수명만 기록한다. 값은 이 파일에 넣지 않는다.
# 실제 값은 .env.local(추적 제외)에만 두며, DEV-004 이전에는 비워 둔 채로 앱이 '미연결' 상태로 동작한다.

# Supabase 공개 설정 (브라우저 노출 가능 값)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase 서버 전용 키 (서버에만 둔다. NEXT_PUBLIC_ 접두사 금지)
SUPABASE_SECRET_KEY=

# 사이트 기준 URL (인증 리디렉션 허용 목록에 사용 예정)
NEXT_PUBLIC_SITE_URL=
